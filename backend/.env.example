# Optional overrides. Every value below has a working default, so the backend
# runs with no .env at all. These are read from the process environment
# (e.g. `export LLM_MODEL=...`) — there is no .env auto-loader.

# --- Inspection database (PostgreSQL) — read by app/db.py and the Alembic migrations ---
# Default: the local `metriq` database over the Unix socket as the current user.
# DATABASE_URL=postgresql+psycopg:///metriq
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/metriq
# Test database used by tests/test_inspection_records.py (its name must end in _test).
# TEST_DATABASE_URL=postgresql+psycopg:///metriq_test

# --- Local LLM (LM Studio, OpenAI-compatible) — read by app/llm.py ---
# Defaults shown; only set these to override. LM_STUDIO_* are the primary names;
# LLM_* still work as a fallback.
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_MODEL=qwen/qwen3-4b
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=qwen/qwen3-4b

# --- MetrIQ Copilot: grounded explanations via OpenRouter ---
# Optional. Without a key, MetrIQ works exactly as before and the copilot panel
# simply says no explanation service is configured. NEVER put this key in the
# frontend, in a VITE_ variable, or in git: backend/.env is gitignored and is
# read automatically at startup (app/openrouter.py::load_env_file).
# OPENROUTER_API_KEY=sk-or-v1-...
# The model is env-driven; nothing in the code hardcodes it. Default and tested:
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free   (free, verified end to end 2026-09-20)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT=60
# Free-tier guards, enforced locally before a request is sent (~50/day, ~20/min):
# OPENROUTER_DAILY_LIMIT=45
# OPENROUTER_MINUTE_LIMIT=15

# --- Certification / Hallmarking grounded answers — final hardening pass ---
# /ask (general BIS Q&A, and Hallmarking, which has no dedicated endpoint) and
# POST /certification-guidance (explain=true) use the SAME OPENROUTER_API_KEY
# but are pinned to their OWN model, independent of the copilot's
# OPENROUTER_MODEL above — even though both currently default to the same Ling
# model, changing one does not change the other. Uses the shared app/openrouter.py
# provider architecture (no separate LLM abstraction, no LM Studio).
# OPENROUTER_GROUNDED_MODEL=inclusionai/ling-3.0-flash-vl:free

# --- Visual product understanding (Milestone 15) — a SEPARATE OpenRouter key ---
# Deliberately NOT the same variable as the copilot's OPENROUTER_API_KEY: the two
# services have independent quotas, and a vision outage must not affect the copilot.
# Without a key, inspection is OCR + deterministic identification exactly as before.
# OPENROUTER_VISION_API_KEY=sk-or-v1-...
# VISION_MODEL=inclusionai/ling-3.0-flash-vl:free
# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_TIMEOUT=60
# Free-tier guards, enforced locally before a request is sent:
# VISION_MAX_IMAGES=2        # images sent per inspection
# VISION_DAILY_LIMIT=40
# VISION_MINUTE_LIMIT=10
